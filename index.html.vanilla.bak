                class="w-full pl-9 pr-3 py-2.5 bg-slate-900 border border-slate-700 rounded-xl text-xs text-white placeholder-slate-500 focus:outline-none focus:border-emerald-500">
              <span class="absolute left-3 top-2.5 text-slate-400 text-sm">🔍</span>
