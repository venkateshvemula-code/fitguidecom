      <!-- 5. Growth Killers: Foods & Habits to Avoid -->
      <div class="fit-card p-6 md:p-8 rounded-2xl mb-12 bg-gradient-to-r from-red-950/20 via-slate-900 to-slate-900 border border-red-800/40">
