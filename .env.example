# ==============================================================================
# FitGuide - Environment Configuration Example
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# PostgreSQL Database Connection URL
DATABASE_URL=postgresql://postgres:fitguide_password@localhost:5432/fitguide_db?schema=public

# Authentication Secrets (NextAuth / JWT)
JWT_SECRET=super_secret_jwt_random_key_replace_in_production_9481237
AUTH_SECRET=fitguide_auth_session_secret_change_me
NEXTAUTH_URL=http://localhost:3000

# Optional Cloud Storage / CDN (for user-submitted exercise videos / images)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Rate Limiting & Security
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000
